# 복사해서 .env로 사용 (.env는 git에 올리지 않음)
DB_URL=jdbc:mysql://localhost:3306/refit
DB_USERNAME=
DB_PASSWORD=

# 32바이트 이상의 랜덤 문자열 (예: openssl rand -base64 48)
JWT_SECRET=
JWT_EMAIL_SECRET=

# 인증 메일 발송용 SMTP 계정 (Gmail은 앱 비밀번호)
MAIL_USERNAME=
MAIL_PASSWORD=

# Google 로그인 클라이언트 ID (쉼표로 여러 개)
GOOGLE_CLIENT_IDS=

# 아래는 선택 (기본값 있음)
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
NFC_ATTENDANCE_URL=http://localhost:5173/nfc/attendance
ATTENDANCE_NFC_EARLY_MINUTES=10
ATTENDANCE_NFC_LATE_AFTER_MINUTES=10
FILE_UPLOAD_DIR=
FILE_BASE_URL=http://localhost:8080

# Google OAuth 클라이언트 ID (쉼표로 여러 개)
GOOGLE_CLIENT_IDS=
